<Window x:Class="AudioToMicWPF.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        Cursor="Cross">
    <Grid>
        <!-- 全屏交互画布 -->
        <Canvas Name="CanvasRoot"
                Background="Transparent"
                PreviewMouseDown="CanvasRoot_PreviewMouseDown"
                PreviewMouseMove="CanvasRoot_PreviewMouseMove"
                PreviewMouseUp="CanvasRoot_PreviewMouseUp">

            <!-- 柔和遮罩层 -->
            <Rectangle Fill="#55000000"
                       Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                       Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"/>

            <!-- Fluent 动态选择框 -->
            <Rectangle Name="SelectionRect"
                       Stroke="#0078D4"
                       StrokeThickness="2"
                       StrokeDashArray="4 2"
                       Visibility="Collapsed"
                       Fill="#200078D4"/>

            <!-- Fluent 悬浮操作控制条 -->
            <Border Name="ButtonPanel"
                    Visibility="Collapsed"
                    Background="#F9FFFFFF"
                    BorderBrush="#D6D6D6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Cursor="Arrow">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.22" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="SaveButton_Click"
                            Style="{DynamicResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"
                            Height="32" Padding="12,0"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:FontIcon Glyph="&#xE74E;" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="保存截图" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="ResetButton_Click"
                            Style="{DynamicResource {x:Static ui:ThemeKeys.DefaultButtonStyleKey}}"
                            Height="32" Padding="10,0"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:FontIcon Glyph="&#xE7A7;" FontSize="13" Margin="0,0,5,0"/>
                            <TextBlock Text="重选" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="CancelButton_Click"
                            Style="{DynamicResource {x:Static ui:ThemeKeys.DefaultButtonStyleKey}}"
                            Height="32" Padding="10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:FontIcon Glyph="&#xE711;" FontSize="13" Margin="0,0,5,0"/>
                            <TextBlock Text="取消" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- 顶部 Fluent 胶囊指引栏 (置于顶层居中) -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,28,0,0"
                Background="#E6202020"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18,8"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:FontIcon Glyph="&#xE722;" FontSize="14" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="拖拽或点击选定语音按钮区域 (右键重选 · ESC 退出)" Foreground="#FFFFFF" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>