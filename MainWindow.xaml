<Window x:Class="AudioToMicWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioToMicWPF"
        mc:Ignorable="d"
        Icon="Images\Wave.png"
        Title="{Binding WindowTitle}" 
        Height="750" Width="500"
        MinHeight="750" MinWidth="500"
        MaxHeight="750" MaxWidth="500"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- 主界面内容 -->
        <Grid Margin="0,0,0,78">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部LOGO区域 -->
            <Grid Grid.Row="0" Margin="0,10,0,87">
                <Image Source="/Images/banner.jpg" Margin="0,-26,0,-68">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#FF000000"/>
                            <!-- 顶部完全不透明 -->
                            <GradientStop Offset="1" Color="#00000000"/>
                            <!-- 底部完全透明 -->
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
            </Grid>

            <!-- 顶部右上角 Fluent 操作栏：语言切换与暗色模式切换 -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="0,12,16,0" 
                        Panel.ZIndex="100">
                <!-- 语言切换按钮（仅保留图标，点击展开 Fluent 子菜单） -->
                <Button x:Name="LanguageButton"
                        Style="{StaticResource FluentHeaderIconButton}"
                        Width="36" Height="32"
                        Margin="0,0,8,0"
                        ToolTip="{DynamicResource Header_Language}"
                        Click="OnLanguageButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource FluentContextMenu}">
                            <MenuItem Header="简体中文"
                                      Style="{StaticResource FluentMenuItem}"
                                      IsChecked="{Binding IsChineseSelected, Mode=OneWay}"
                                      Click="OnSelectChinese_Click"/>
                            <MenuItem Header="English"
                                      Style="{StaticResource FluentMenuItem}"
                                      IsChecked="{Binding IsEnglishSelected, Mode=OneWay}"
                                      Click="OnSelectEnglish_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                               Text="&#xE774;" 
                               FontSize="14" 
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"/>
                </Button>

                <!-- 深色/浅色模式切换按钮 -->
                <Button x:Name="ThemeToggleButton"
                        Style="{StaticResource FluentHeaderIconButton}"
                        Width="36" Height="32"
                        ToolTip="{Binding ThemeButtonToolTip}"
                        Click="OnThemeToggle_Click">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                               Text="{Binding ThemeIconGlyph}" 
                               FontSize="14" 
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- 顶部两个操作大按钮（左侧固定对齐，无右外边距，防止裁切） -->
            <Button x:Name="FilePickerButton"
                    Width="130" Height="130"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="10,36,0,0" Grid.RowSpan="2"
                    Click="OnPickFile">
                <Button.Content>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image AutomationProperties.Name="Slice" Source="/Images/audio.png" Width="80" Height="80"/>
                        <TextBlock Text="{DynamicResource Top_SelectAudio}" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button Width="130" Height="130"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="153,36,0,0" Grid.RowSpan="2"
                    Click="GetQQWindow">
                <Button.Content>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image AutomationProperties.Name="Slice" Source="/Images/window.png" Width="80" Height="80"/>
                        <TextBlock Text="{DynamicResource Top_SelectWindow}" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button.Content>
            </Button>

            <!-- 主内容区域 -->
            <Grid Grid.Row="1" Margin="10,45,10,-75" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="70"/>
                </Grid.RowDefinitions>

                <!-- 设置卡片组 -->
                <StackPanel Height="360">
                
                    <!-- 音频文件选择卡片 -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,1,0,13" Height="108">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标 -->
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8D6;" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,12,0"/>

                            <!-- 标题与说明 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="OnPickFile">
                                <TextBlock Text="{DynamicResource Card_AudioSelection_Title}" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Card_AudioSelection_Desc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 路径显示区 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{DynamicResource Card_AudioSelection_Header}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextMediumBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="pathShower"
                                         Height="62"
                                         Width="240"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         Text="{Binding SelectedFilePath, Mode=OneWay}"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         IsTabStop="False"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Padding="6,4"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 目标窗口选择卡片 -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,1,0,13" Height="108">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标 -->
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xF7ED;" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,12,0"/>

                            <!-- 标题与说明 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="GetQQWindow">
                                <TextBlock Text="{DynamicResource Card_WindowSelection_Title}" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Card_WindowSelection_Desc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 窗口信息显示区 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{DynamicResource Card_WindowSelection_Header}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextMediumBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="proccessName"
                                         Height="62"
                                         Width="240"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Background="{DynamicResource ControlBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}"
                                         Text="{Binding ProgramName, Mode=OneWay}"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         IsTabStop="False"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Padding="6,4"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 虚拟声卡设置卡片 -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,1,0,13" Height="108">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标 -->
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEC72;" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,12,0"/>

                            <!-- 标题与说明 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource Card_Driver_Title}" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding DriverStatusDescription}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 按钮组 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Width="80" Height="36" Margin="0,0,6,0" Padding="2" Click="OnDriverActionButton_Click">
                                    <TextBlock Text="{Binding DriverActionButtonText}" 
                                               FontSize="{Binding DriverActionButtonFontSize}" 
                                               TextWrapping="Wrap" 
                                               TextAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Center"/>
                                </Button>
                                <Button Width="130" Height="36" Margin="0,0,6,0" ToolTip="{DynamicResource Driver_Tooltip_Pipeline}" Click="OnViewPipeline_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Driver_View_Pipeline}" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button ToolTip="{DynamicResource Driver_Tooltip_Refresh}" Padding="6" Height="36" Width="36" Click="OnRefreshDevices">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72C;" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- 按钮图像置信度调整 -->
                <Grid Grid.Row="3" Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource Slider_Confidence}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,8,0" FontSize="12.5"/>
                    <Slider x:Name="thresholdSlider" Grid.Column="1" Orientation="Horizontal" Minimum="0.05" Maximum="1.00" Value="0.70" AutoToolTipPlacement="None"
                        TickFrequency="0.05" TickPlacement="BottomRight" IsSnapToTickEnabled="True" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="4,0,8,0"/>
                    <TextBox x:Name="thresholdNumber" Grid.Column="2" Text="{Binding Value, ElementName=thresholdSlider, Mode=TwoWay, StringFormat={}{0:P0}}"
                        Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                        Width="52" Height="26" VerticalAlignment="Center" Margin="0,0,10,0" TextAlignment="Center" IsReadOnly="True" Padding="0,3"/>
                </Grid>

                <!-- 截图按钮 -->
                <Button Grid.Row="5" Content="{DynamicResource Btn_Capture}" Click="OnCaptureScreen" 
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                        Width="210" Height="42" Margin="20,0,0,21"/>

                <!-- 播放按钮 -->
                <Button Grid.Row="5" Content="{DynamicResource Btn_Play}" Click="OnPlayAudio"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                        Style="{DynamicResource AccentButtonStyle}"
                        Width="210" Height="42" Margin="0,0,20,21"/>
            </Grid>
        </Grid>

        <!-- 原生 Fluent 对话框蒙版层 -->
        <Grid x:Name="DialogHost" Visibility="Collapsed" Background="{DynamicResource DialogOverlayBrush}" Panel.ZIndex="1000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource DialogBackgroundBrush}" 
                    BorderBrush="{DynamicResource DialogBorderBrush}" 
                    BorderThickness="1"
                    CornerRadius="8" MinWidth="380" MaxWidth="440" Padding="22"
                    Effect="{DynamicResource DialogShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="DialogTitle" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <ContentControl x:Name="DialogContent" Grid.Row="1" Margin="0,0,0,20" Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogPrimaryBtn" MinWidth="80" Height="32" Padding="12,0" Margin="0,0,8,0"
                                Style="{DynamicResource AccentButtonStyle}" Click="OnDialogPrimary_Click"/>
                        <Button x:Name="DialogCloseBtn" MinWidth="80" Height="32" Padding="12,0"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Click="OnDialogClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
