             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AudioToMicWPF"
             ThemeMode="System"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <DropShadowEffect x:Key="DialogShadow" BlurRadius="24" Direction="270" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
